# Copy to .env (gitignored) and fill in what applies. Every line is optional.
# A variable already set in the real environment wins over this file.

# Your public URL, if you host it. Used as the OpenRouter attribution referer.
# SPICE_PUBLIC_ORIGIN=https://spice.example.com

# A Markdown checklist that gets one "rate this" line per generated recipe
# (an Obsidian note works well). Leave unset to turn the reminder off.
# SPICE_TODO_FILE=/path/to/vault/To Do/Recipes.md

# The OpenRouter key can live here, in OPENROUTER_API_KEY, or in data/openrouter.key.
# OPENROUTER_API_KEY=sk-or-...

# SPICE_PORT=5003
# SPICE_MODEL=openai/gpt-5.6-luna
# SPICE_DATA_DIR=./data
